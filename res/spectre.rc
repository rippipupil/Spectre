#include <winver.h>

1 ICON "spectre.ico"
1 24 "spectre.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040a04b0"
    BEGIN
      VALUE "CompanyName", "Spectre"
      VALUE "FileDescription", "Spectre - clips y grabación de pantalla"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "Spectre"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "spectre.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040a, 1200
  END
END
